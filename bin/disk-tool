Project = namedtuple("Project", "entry names next_to contains")


def P(id, names, next_to, contains, description):
    entry = E(id, "dev", "**/" + names[0], "command", description)
    return Project(entry, tuple(names), tuple(next_to), tuple(contains))


# Build output and dependencies inside project folders. Looked for anywhere in the home
# folder except ~/Library, ~/Applications, hidden top-level folders (~/.something) and app
# bundles. A folder only counts when its marker is there: a file next to it (next_to) or
# inside it (contains).
PROJECT_FOLDERS = [
    P("node-modules", ["node_modules"], ["package.json"], [],
      "JavaScript packages of one project. `npm install` (or pnpm, yarn) brings them back."),
    P("python-venv", [".venv", "venv"], [], ["pyvenv.cfg"],
      "Python environment of one project. Make it again and reinstall its packages."),
    P("rust-target", ["target"], ["Cargo.toml"], [],
      "Rust build output. `cargo build` makes it again."),
    P("swift-build", [".build"], ["Package.swift"], [],
      "Swift package build output. `swift build` makes it again."),
    P("gradle-build", ["build"], ["build.gradle", "build.gradle.kts"], [],
      "Gradle build output. The next build makes it again."),
    P("gradle-project-cache", [".gradle"],
      ["settings.gradle", "settings.gradle.kts", "build.gradle", "build.gradle.kts"], [],
      "Gradle's cache for one project. The next build makes it again."),
    P("cocoapods-pods", ["Pods"], ["Podfile"], [],
      "CocoaPods dependencies of one project. `pod install` brings them back."),
    P("next-build", [".next"], ["package.json"], [],
      "Next.js build output. The next build makes it again."),
    P("dart-tool", [".dart_tool"], ["pubspec.yaml"], [],
      "Dart or Flutter build files. `flutter pub get` brings them back."),
    P("tox-envs", [".tox"], ["tox.ini", "pyproject.toml", "setup.cfg"], [],
      "Python test environments made by tox. tox makes them again."),
]

UNKNOWN = E("unknown", "unknown", "*", "no",
            "Not in the catalog. Look at it and decide yourself.")
PRIVATE = E("private", "private", "*", "no",
            "Private folder: only its total size is measured; nothing inside is listed.")

ENTRIES = {e.id: e for e in CATALOG + [p.entry for p in PROJECT_FOLDERS] + [UNKNOWN, PRIVATE]}

_BY_KEY = {}
for _e in CATALOG:
    _parts = tuple(_e.pattern.split("/"))
    _BY_KEY.setdefault((_parts[0], len(_parts)), []).append((_parts, _e))
_MAX_DEPTH = max(len(e.pattern.split("/")) for e in CATALOG)
_PROJECT_BY_NAME = {}
for _p in PROJECT_FOLDERS:
    for _n in _p.names:
        _PROJECT_BY_NAME.setdefault(_n, []).append(_p)


def _specificity(parts):
    literal = sum(1 for p in parts if not any(c in p for c in "*?["))
    return (literal, sum(len(p.replace("*", "")) for p in parts))


def match_path(rel):
    """The catalog entry for a path (a tuple of names under home), or None."""
    if len(rel) > _MAX_DEPTH:
        return None
    best = None
    for parts, entry in _BY_KEY.get((rel[0], len(rel)), ()):
        if all(fnmatch.fnmatchcase(n, p) for n, p in zip(rel[1:], parts[1:])):
            score = _specificity(parts)
            if best is None or score > best[0]:
                best = (score, entry)
    return best[1] if best else None


def _project_allowed(rel, owner):
    if owner is not None and owner.entry.kind != "user":
        return False
    if rel[0] in ("Library", "Applications") or rel[0].startswith("."):
        return False
    return not any(part.endswith(".app") for part in rel[:-1])


def match_project(rel, sibling_names, present_markers):
    """A project-output entry for a folder, from the names next to it and the markers
    found inside it (the walker checks those)."""
    for project in _PROJECT_BY_NAME.get(rel[-1], ()):
        if any(m in sibling_names for m in project.next_to):
            return project.entry
        if any(m in present_markers for m in project.contains):
            return project.entry
    return None


# ----------------------------------------------------------------------------- places

def resolve_home(arg):
    home = arg or os.environ.get(ENV_HOME) or os.path.expanduser("~")
    home = os.path.realpath(os.path.expanduser(home))
    if not os.path.isdir(home):
        raise SystemExit(f"{NAME}: {home} is not a folder")
    return home


def outside_root(home_given):
    """Where the folders outside home are: "/" for the real home folder. With another
    home (tests, --home) only a root named in the environment, never the real one."""
    root = os.environ.get(ENV_ROOT)
    if root:
        return os.path.realpath(root)
    return None if home_given else "/"


def _xdg(var, home, *default):
    value = os.environ.get(var, "")
    return value if os.path.isabs(value) else os.path.join(home, *default)


def policy_path(home):
    return os.path.join(_xdg("XDG_CONFIG_HOME", home, ".config"), NAME, "policy.json")


def private_path(home):
    return os.path.join(_xdg("XDG_CONFIG_HOME", home, ".config"), NAME, "private.json")


def load_private(home):
    """Private folders, as paths under home ("Developer/Acme")."""
    data = _read_json(private_path(home)) or {}
    folders = data.get("folders", []) if isinstance(data, dict) else []
    return sorted({f for f in folders if isinstance(f, str) and f and not f.startswith("/")})


def _inside(rel, folders):
    """The private folder `rel` is in (or is), else None. rel and folders: "a/b" strings."""
    for f in folders:
        if rel == f or rel.startswith(f + "/"):
            return f
    return None


def state_dir(home):
    return os.path.join(_xdg("XDG_STATE_HOME", home, ".local", "state"), NAME)


def tool_dir():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _write_json(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def _read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def latest_scan(home):
    return _read_json(os.path.join(state_dir(home), "latest.json"))


# ----------------------------------------------------------------------------- display

def fmt_bytes(n, sign=False):
    value = float(abs(n))
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if value < 1000 or unit == "TB":
            break
        value /= 1000
    text = f"{value:.0f} {unit}" if unit in ("B", "KB") else f"{value:.1f} {unit}"
    if n < 0:
        return "-" + text
    return ("+" + text) if sign else text


def iso(t):
    return datetime.datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds")


def when(t):
    return datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d %H:%M")


def disp(rel):
    return "~/" + rel if rel else "~"


def days_since(t, now=None):
    return max(0, int(((now if now is not None else _now()) - t) // 86400))


# ----------------------------------------------------------------------------- scan

class Item:
    __slots__ = ("rel", "entry", "bytes", "newest", "partial", "unreadable", "children",
                 "grandchildren", "private_children")

    def __init__(self, rel, entry):
        self.rel, self.entry = rel, entry
        self.bytes, self.newest = 0, 0.0
        self.partial = self.unreadable = False
        self.children = {}
        self.grandchildren = {} if entry is UNKNOWN else None
        self.private_children = []  # private folders inside: shown as one entry each

    def add(self, rel, size, changed):
        self.bytes += size
        if changed > self.newest:
            self.newest = changed
        depth = len(self.rel)
        if len(rel) > depth:
            key = rel[depth]
            self.children[key] = self.children.get(key, 0) + size
            if self.grandchildren is not None:
                key = "/".join(rel[depth:depth + 2])
                self.grandchildren[key] = self.grandchildren.get(key, 0) + size

    def add_files(self, folder, size, changed):
        """Plain files the walker summed for one folder."""
        self.add(folder + ("(files)",), size, changed)


def _refusal(exc):
    if exc.errno in (errno.ENOENT, errno.ENOTDIR):
        return "gone"
    if exc.errno == errno.EPERM:
        return "privacy"
    if exc.errno == errno.EACCES:
        return "permission"
    return "error"


NOT_MEASURED_TEXT = {
    "privacy": "macOS privacy protection",
    "no-answer": "macOS did not answer (privacy prompt?)",
    "skipped-after-stalls": "skipped after macOS did not answer next to it",
    "skipped-stall-budget": "skipped: macOS kept not answering",
    "permission": "no permission to read it",
    "other-disk": "another disk or volume, not counted",
    "error": "could not be read",
}


# ----------------------------------------------------------------------------- walker
# Every file-system read of a scan or a clean check happens in child processes
# (`_walk`). macOS can hold open() on a protected folder while a privacy prompt waits,
# possibly forever; the parent watches each child and stops one that goes silent, lists
# that folder as not measured, and goes on with a fresh child. Several children walk in
# parallel, which is where the speed comes from: the time goes into file-system calls.

ENV_TEST_HANG = NAME.upper().replace("-", "_") + "_TEST_HANG"  # tests: block on these names
_CONTAINS = {name: tuple(m for p in projects for m in p.contains)
             for name, projects in _PROJECT_BY_NAME.items()}
_MARKER_FILES = {m for p in PROJECT_FOLDERS for m in p.next_to}  # always sent one by one

# Walked last and one at a time, so a time limit or a row of prompts costs these rather
# than the rest: 1 = folders macOS usually guards with a privacy prompt, 2 = cloud drives.
SLOW_AREAS = {
    ("Library", "Containers"): 1, ("Library", "Group Containers"): 1,
    ("Library", "Mail"): 1, ("Library", "Messages"): 1, ("Library", "Safari"): 1,
    ("Library", "Mobile Documents"): 2, ("Library", "CloudStorage"): 2,
}


def _slow_rank(rel):
    if rel in SLOW_AREAS:
        return SLOW_AREAS[rel]
    return 1 if rel and rel[-1].endswith(".photoslibrary") else 0


def _guarded(rel):
    """0 for ordinary folders, else the highest slow rank of the folder or one above it."""
    return max(_slow_rank(rel[:i]) for i in range(len(rel) + 1))


def _walks_into(sub, root, lim, skip_slow):
    """Whether the child walking `root` goes on into `sub`; otherwise the parent queues
    it. The child and the parent both ask this, so they always agree."""
    if skip_slow and _slow_rank(sub):
        return False
    return lim is None or len(sub) - len(root) <= lim


class _Out:
    """The child's stdout, written in batches. A thread flushes every 50 ms, so the parent
    still learns which folder the child opened when that open() blocks."""

    def __init__(self):
        self.parts, self.lock, self.fd = [], threading.Lock(), sys.stdout.fileno()
        threading.Thread(target=self._loop, daemon=True).start()

    def send(self, msg):
        with self.lock:
            self.parts.append(json.dumps(msg, separators=(",", ":")))
            full = len(self.parts) >= 512
        if full:
            self.flush()

    def flush(self):
        with self.lock:
            if not self.parts:
                return
            data = ("\n".join(self.parts) + "\n").encode()
            self.parts = []
            try:
                while data:
                    data = data[os.write(self.fd, data):]
            except OSError:  # the parent is gone
                os._exit(1)

    def _loop(self):
        while True:
            time.sleep(0.05)
            self.flush()


def _private_total(path, dev, out, hang):
    """Total allocated size under a private folder, and how many folders in it could not
    be read. Nothing about what is inside leaves this function."""
    total, unread, seen, stack, count = 0, 0, set(), [path], 0
    while stack:
        p = stack.pop()
        if hang and os.path.basename(p) in hang:
            while True:
                time.sleep(3600)
        try:
            with os.scandir(p) as it:
                for de in it:
                    count += 1
                    if count % 1000 == 0:
                        out.send({"h": 1})
                    try:
                        st = de.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if stat.S_ISDIR(st.st_mode):
                        if st.st_dev != dev:
                            continue
                        stack.append(de.path)
                    elif st.st_nlink > 1:
                        if (st.st_dev, st.st_ino) in seen:
                            continue
                        seen.add((st.st_dev, st.st_ino))
                    total += st.st_blocks * 512
        except OSError:
            unread += 1
    return total, unread


def walker_main(base):
    """The child. Reads jobs (one JSON line each) on stdin and writes one JSON line per
    folder. Plain files deep in the tree are summed per folder; the parent only needs
    shallow files, hard links and files a catalog row could match one by one."""
    signal.signal(signal.SIGINT, signal.SIG_IGN)  # the parent decides when to stop
    hang = set(filter(None, os.environ.get(ENV_TEST_HANG, "").split(",")))
    dev = os.lstat(base).st_dev
    out = _Out()
    for line in sys.stdin:
        job = json.loads(line)
        lim, skip_slow, match = job.get("lim"), job.get("skip_slow", True), job.get("match")
        describe = {tuple(r) for r in job.get("describe", ())}
        private = {tuple(r) for r in job.get("private", ())}
        for root in (tuple(r) for r in job["roots"]):
            stack = [root]
            while stack:
                rel = stack.pop()
                out.send({"o": rel})  # if open() blocks now, the parent knows where
                if rel in private:  # one message with the total: no names, no folders
                    total, unread = _private_total(os.path.join(base, *rel), dev, out, hang)
                    out.send({"d": rel, "p": [total, unread]})
                    continue
                if rel and rel[-1] in hang:
                    while True:
                        time.sleep(3600)
                msg = {"d": rel}
                path = os.path.join(base, *rel)
                if rel in describe:
                    try:
                        st = os.lstat(path)
                    except OSError as exc:
                        msg["err"] = _refusal(exc)
                        out.send(msg)
                        continue
                    kind = ("link" if stat.S_ISLNK(st.st_mode) else
                            "dir" if stat.S_ISDIR(st.st_mode) else "file")
                    if kind == "dir" and st.st_dev != dev:
                        kind = "other-disk"
                    msg["self"] = [kind, st.st_blocks * 512, max(st.st_mtime, st.st_ctime)]
                    if kind != "dir":
                        out.send(msg)
                        continue
                rows, subdirs, files = [], [], [0, 0.0, 0]
                try:
                    with os.scandir(path) as it:
                        for count, de in enumerate(it, 1):
                            if count % 1000 == 0:
                                out.send({"h": 1})
                            try:
                                st = de.stat(follow_symlinks=False)
                            except OSError:
                                continue
                            size = st.st_blocks * 512
                            newest = st.st_mtime if st.st_mtime > st.st_ctime else st.st_ctime
                            if stat.S_ISDIR(st.st_mode):
                                kind = 1 if st.st_dev == dev else 2  # 2: another disk
                                markers = 0
                                if kind == 1 and de.name in _CONTAINS:
                                    markers = [m for m in _CONTAINS[de.name]
                                               if os.path.lexists(os.path.join(de.path, m))]
                                rows.append([de.name, kind, size, newest, 0, markers])
                                if kind == 1:
                                    subdirs.append(rel + (de.name,))
                            elif (st.st_nlink > 1 or len(rel) < 3 or de.name in _MARKER_FILES
                                  or (match and match_path(rel + (de.name,)))):
                                link = [st.st_dev, st.st_ino] if st.st_nlink > 1 else 0
                                rows.append([de.name, 0, size, newest, link, 0])
                            else:
                                files[0] += size
                                files[2] += 1
                                if newest > files[1]:
                                    files[1] = newest
                except OSError as exc:
                    msg["err"] = _refusal(exc)
                    out.send(msg)
                    continue
                msg["e"] = rows
                if files[2]:
                    msg["f"] = files
                out.send(msg)
                for sub in reversed(subdirs):
                    if _walks_into(sub, root, lim, skip_slow):
                        stack.append(sub)
        out.send({"done": True})
        out.flush()
    out.flush()
    return 0


def _stop(proc):
    if proc.poll() is None:
        proc.kill()  # only ever a child this process started
    proc.wait()
    for stream in (proc.stdin, proc.stdout):
        if stream:
            try:
                stream.close()
            except OSError:
                pass


class _Walker:
    """One child process and what it is doing."""

    def __init__(self, base, sel):
        self.proc = subprocess.Popen(
            [sys.executable, "-I", os.path.realpath(__file__), "_walk", base],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
        self.fd, self.buf, self.sel = self.proc.stdout.fileno(), b"", sel
        self.busy, self.pending, self.current, self.last = False, {}, None, 0.0
        self.lim, self.skip_slow = None, True
        sel.register(self.fd, selectors.EVENT_READ, self)

    def start(self, roots, lim, skip_slow, describe, match, private=()):
        job = {"roots": [list(r) for r in roots], "lim": lim, "skip_slow": skip_slow,
               "describe": [list(r) for r in roots if r in describe], "match": match,
               "private": [list(r) for r in private]}
        data = (json.dumps(job) + "\n").encode()
        while data:
            data = data[os.write(self.proc.stdin.fileno(), data):]
        self.busy, self.lim, self.skip_slow = True, lim, skip_slow
        self.pending = {r: r for r in roots}  # folder -> the job root it belongs to
        self.current, self.last = None, time.monotonic()

    def close(self):
        try:
            self.sel.unregister(self.fd)
        except (KeyError, ValueError):
            pass
        _stop(self.proc)


def walk(base, roots, on_listing, time_limit, stall_limit, describe=False, skip_slow=True,
         match=False, first_lim=None, workers=None, on_no_answer=None, on_skipped=None,
         on_progress=None, private=()):
    """Walk folders under `base` in child processes; never touch the file system here.

    roots: {rel: ctx}. on_listing(rel, ctx, msg) returns {name: ctx} for subfolders.
    on_no_answer(rel, ctx, why, waited): a folder a child got stuck on ("no-answer") or
    died on ("error"). on_skipped(parent, [(rel, ctx)], why): folders given up without
    trying, after STALLS_PER_PARENT stalls next to them ("parent") or once stalls used up
    STALL_BUDGET ("budget"). Returns (cut, pending): cut is True when the time limit ended
    the walk; pending maps every folder not walked to its ctx.
    """
    deadline = time.monotonic() + time_limit
    workers = workers or WALKERS
    ctxs = dict(roots)  # every folder known but not listed yet
    describe = set(roots) if describe else set()
    normal, guarded = collections.deque(), collections.deque()
    stalls, state = {}, {"spent": 0.0, "failures": 0}
    walkers = []
    sel = selectors.DefaultSelector()

    def queue(rel, lim):
        (guarded if skip_slow and _guarded(rel) else normal).append((rel, lim))

    for rel in roots:
        queue(rel, first_lim)

    def limit_for(w):
        limit = stall_limit
        if w.current is not None and w.current[:-1] in stalls:
            limit = min(limit, SIBLING_STALL_LIMIT)
        return min(limit, max(LATE_STALL_LIMIT, STALL_BUDGET - state["spent"]))

    def idle_walker():
        for w in walkers:
            if not w.busy:
                return w
        if len(walkers) < workers:
            walkers.append(_Walker(base, sel))
            return walkers[-1]
        return None

    def dispatch():
        while normal:
            w = idle_walker()
            if w is None:
                return
            rel, lim = normal.popleft()
            batch = [rel]
            while normal and len(batch) < UNITS_PER_JOB and normal[0][1] == lim:
                batch.append(normal.popleft()[0])
            w.start(batch, lim, skip_slow, describe, match, private)
        if guarded and not any(w.busy for w in walkers):  # last, one at a time
            nxt = min(guarded, key=lambda unit: (_guarded(unit[0]), unit[0]))
            guarded.remove(nxt)
            idle_walker().start([nxt[0]], None, skip_slow, describe, match, private)

    def skip(parent, why, test):
        dropped = []
        for q in (normal, guarded):
            keep = [(r, lim) for r, lim in q if not test(r)]
            dropped += [r for r, _ in q if test(r)]
            q.clear()
            q.extend(keep)
        groups = {}
        for r in dropped:
            groups.setdefault(parent if parent is not None else r[:-1], []).append(
                (r, ctxs.pop(r, None)))
        for p, rows in groups.items():
            if on_skipped:
                on_skipped(p, rows, why)

    def give_up(w, stalled):
        waited = limit_for(w)
        stuck = w.current
        w.close()
        walkers.remove(w)
        for rel in w.pending:
            if rel != stuck:
                queue(rel, UNIT_DEPTH)
        if stuck is None or stuck not in ctxs:
            state["failures"] += 1  # silent outside any folder: retry, but not forever
            return state["failures"] <= 3
        ctx = ctxs.pop(stuck)
        if stalled:
            state["spent"] += waited
            parent = stuck[:-1]
            stalls[parent] = stalls.get(parent, 0) + 1
        if on_no_answer:
            on_no_answer(stuck, ctx, "no-answer" if stalled else "error", waited)
        if stalled and stalls[stuck[:-1]] >= STALLS_PER_PARENT:
            parent = stuck[:-1]
            skip(parent, "parent", lambda r: r[:-1] == parent)
        if state["spent"] >= STALL_BUDGET:
            skip(None, "budget", lambda r: _guarded(r))
        return True

    def handle(w, msg):
        if "o" in msg:
            w.current = tuple(msg["o"])
        elif "d" in msg:
            rel = tuple(msg["d"])
            root = w.pending.pop(rel, rel)
            subs = on_listing(rel, ctxs.pop(rel, None), msg) or {}
            for row in msg.get("e") or ():
                if row[1] == 1:
                    sub = rel + (row[0],)
                    ctxs[sub] = subs.get(row[0])
                    if _walks_into(sub, root, w.lim, w.skip_slow):
                        w.pending[sub] = root
                    else:
                        queue(sub, UNIT_DEPTH)
            w.current = None
        elif "done" in msg:
            for rel in w.pending:  # nothing should be left; requeue to be safe
                queue(rel, UNIT_DEPTH)
            w.busy, w.pending, w.current = False, {}, None

    cut = False
    try:
        while True:
            now = time.monotonic()
            if now >= deadline:
                cut = True
                break
            dispatch()
            busy = [w for w in walkers if w.busy]
            if not busy:
                break
            wait = min([1.0, deadline - now] + [w.last + limit_for(w) - now for w in busy])
            dead = set()
            for key, _ in sel.select(max(0.0, wait)):
                w = key.data
                chunk = os.read(w.fd, 1 << 20)
                if not chunk:
                    dead.add(w)
                    continue
                w.last = time.monotonic()
                *lines, w.buf = (w.buf + chunk).split(b"\n")
                for line in lines:
                    handle(w, json.loads(line))
            now = time.monotonic()
            for w in busy:
                if w in dead or (w.busy and now - w.last >= limit_for(w)):
                    if not give_up(w, stalled=w not in dead):
                        cut = True
                        break
            if cut:
                break
            if on_progress:
                on_progress(next((w.current for w in walkers if w.busy and w.current), None))
    finally:
        for w in walkers:
            w.close()
        sel.close()
    return cut, ctxs


def scan_home(home, time_limit, stall_limit=None, progress=False, root=None, private=None):
    """Walk the home folder once (in child processes), then, with `root`, the folders
    outside it. `time_limit` covers both. Returns the full result."""
    stall_limit = STALL_LIMIT if stall_limit is None else stall_limit
    started, t0 = _now(), time.monotonic()
    outside_budget = min(OUTSIDE_TIME_LIMIT, time_limit * 0.1) if root else 0
    private = load_private(home) if private is None else private
    private_rels = {tuple(p.split("/")) for p in private}
    items, unknown, not_measured, seen, no_answer = {}, {}, [], set(), []
    stats = {"folders": 0, "bytes": 0, "shown": t0}

    def anchor(name):
        if name not in unknown:
            unknown[name] = Item((name,), UNKNOWN)
        return unknown[name]

    def mark(rel, owner):
        target = owner if owner is not None else anchor(rel[0])
        if target.rel == rel:
            target.unreadable = True
        else:
            target.partial = True
        return target

    def blocked(rel, owner, reason):
        target = mark(rel, owner)
        row = {"rel": "/".join(rel), "reason": reason}
        if target.rel == rel and target.entry is not UNKNOWN:
            row["id"] = target.entry.id
            row["description"] = target.entry.description
        not_measured.append(row)

    def on_listing(rel, owner, msg):
        stats["folders"] += 1
        if "err" in msg:
            if msg["err"] == "gone":
                return {}
            if not rel:
                raise SystemExit(f"{NAME}: cannot read {home}")
            blocked(rel, owner, msg["err"])
            return {}
        if "p" in msg:  # a private folder: its total, nothing else
            total, unread = msg["p"]
            owner.bytes += total
            owner.partial = owner.partial or unread > 0
            stats["bytes"] += total
            return {}
        rows, names, subs = msg["e"], None, {}
        for name, kind, size, newest, link, markers in rows:
            crel = rel + (name,)
            if kind == 2:
                not_measured.append({"rel": "/".join(crel), "reason": "other-disk"})
                continue
            if crel in private_rels:
                item = items[crel] = Item(crel, PRIVATE)
                (owner if owner is not None else anchor(crel[0])).private_children.append(item)
                item.bytes += size
                stats["bytes"] += size
                subs[name] = item
                continue
            child_owner = owner
            entry = match_path(crel)
            if entry is None and kind == 1 and _project_allowed(crel, owner):
                if names is None:
                    names = {r[0] for r in rows}
                entry = match_project(crel, names, markers or ())
            if entry is not None:
                child_owner = Item(crel, entry)
                items[crel] = child_owner
            if link:
                key = tuple(link)
                if key in seen:
                    size = 0
                else:
                    seen.add(key)
            target = child_owner if child_owner is not None else anchor(crel[0])
            target.add(crel, size, newest)
            stats["bytes"] += size
            if kind == 1:
                subs[name] = child_owner
        if "f" in msg:  # plain files summed by the child
            size, newest, _count = msg["f"]
            (owner if owner is not None else anchor(rel[0])).add_files(rel, size, newest)
            stats["bytes"] += size
        return subs

    def on_no_answer(rel, owner, why, waited):
        blocked(rel, owner, why)
        no_answer.append(rel)
        if progress:
            text = (f"macOS did not answer in {_duration(waited)} (privacy prompt?)"
                    if why == "no-answer" else "could not be read")
            print(f"  {_short(rel)}: {text}; skipping it", file=sys.stderr, flush=True)

    def on_skipped(parent, rows, why):
        for rel, owner in rows:
            mark(rel, owner)
        reason = "skipped-after-stalls" if why == "parent" else "skipped-stall-budget"
        # names: which folders were skipped, so the next scan can tell "measured now,
        # skipped last time" from "new" (saved scans only; not in `scan --json`)
        not_measured.append({"rel": "/".join(parent), "reason": reason, "count": len(rows),
                             "names": sorted(rel[-1] for rel, _ in rows)})
        if progress:
            print(f"  {_short(parent)}: {_skipped_text(reason, len(rows))}",
                  file=sys.stderr, flush=True)

    def on_progress(current):
        now = time.monotonic()
        if now - stats["shown"] >= PROGRESS_EVERY:
            stats["shown"] = now
            where = _short(current) if current is not None else "..."
            print(f"  scanning {where}  ({stats['folders']} folders, "
                  f"{fmt_bytes(stats['bytes'])} so far)", file=sys.stderr, flush=True)

    timed_out, pending = walk(home, {(): None}, on_listing, time_limit - outside_budget,
                              stall_limit,
                              match=True, first_lim=FIRST_DEPTH, private=private_rels,
                              on_no_answer=on_no_answer, on_skipped=on_skipped,
                              on_progress=on_progress if progress else None)

    # What the time limit left out: the items concerned are only partly measured.
    areas = {}
    for rel, owner in pending.items():
        if not rel:
            areas[()] = "not started"
            continue
        (owner if owner is not None else anchor(rel[0])).partial = True
        area = rel[:2] if rel[0] == "Library" and len(rel) >= 2 else rel[:1]
        if rel == area or areas.get(area) != "not started":
            areas[area] = "not started" if rel == area else "partly"
    not_reached = [{"rel": "/".join(a), "status": st} for a, st in sorted(areas.items())]

    nested = {}  # unknown top-level folder -> items of other kinds inside it
    for it in items.values():
        if it.rel[0] in unknown and len(it.rel) > 1:
            nested.setdefault(it.rel[0], []).append(it)
    all_items = list(items.values()) + list(unknown.values())
    records = [_record(it, home, started, nested.get(it.rel[0]) if it.entry is UNKNOWN else None)
               for it in all_items if not it.unreadable]
    records.sort(key=lambda r: -r["bytes"])
    reasons = []
    if timed_out:
        reasons.append(f"stopped after the time limit ({_duration(time_limit)}); "
                       "sizes are at least what is shown")
    skipped = sum(r.get("count", 0) for r in not_measured if r["reason"].startswith("skipped"))
    if no_answer or skipped:
        text = (f"macOS did not answer for {len(no_answer)} folder"
                f"{'s' if len(no_answer) != 1 else ''} (privacy prompt?)")
        if skipped:
            text += f" and {skipped} more next to them were skipped"
        reasons.append(text + "; listed as not measured")
    measured = sum(r["bytes"] for r in records)
    outside = {"scanned": False}
    if root:
        left = time_limit - (time.monotonic() - t0)
        if progress:
            print("  outside your home folder: sizes only", file=sys.stderr, flush=True)
        outside = scan_outside(root, home, max(0.0, left), stall_limit)
    missing = sum(r.get("count", 1) for r in not_measured if r["reason"] != "other-disk")
    return {
        "tool": NAME,
        "version": VERSION,
        "home": home,
        "scanned_at": iso(started),
        "scanned_at_epoch": started,
        "seconds": round(time.monotonic() - t0, 1),
        "complete": not reasons,
        "timed_out": timed_out,
        "incomplete_reason": "; ".join(reasons) or None,
        "disk": disk_numbers(home, measured, missing,
                             outside["bytes"] if outside["scanned"] else None),
        "measured_bytes": measured,
        "outside": outside,
        "not_reached": not_reached,
        "private": sorted(private),
        "kinds": {k: sum(r["bytes"] for r in records if r["kind"] == k) for k in KINDS},
        "not_measured": sorted(not_measured, key=lambda r: r["rel"]),
        "items": records,
    }


def _skipped_text(reason, count):
    many = f"{count} folder{'s' if count != 1 else ''}"
    if reason == "skipped-after-stalls":
        return (f"{count} more folder{'s' if count != 1 else ''} skipped after macOS did not "
                f"answer for {STALLS_PER_PARENT} of them")
    return f"{many} skipped: macOS kept not answering ({_duration(STALL_BUDGET)} spent waiting)"


# ----------------------------------------------------------------------------- outside home

ENV_ROOT = NAME.upper().replace("-", "_") + "_ROOT"  # tests: a stand-in for "/"
OUTSIDE = [  # folders outside the home folder, measured read-only, never cleaned
    ("Applications", "Apps for every account on this Mac."),
    ("Library", "System-wide app data, caches and support files."),
    ("Users/Shared", "The folder every account on this Mac shares."),
    ("private/var", "System data: logs, caches, swap (only what your account may read)."),
    ("opt", "Homebrew on Apple silicon, and other tools in /opt."),
    ("usr/local", "Homebrew on Intel Macs, and other tools in /usr/local."),
]


def _snapshot_count(root):
    """Local Time Machine snapshots on the start-up disk, or None."""
    if root != "/":
        return None
    try:
        out = subprocess.run(["tmutil", "listlocalsnapshots", "/"], capture_output=True,
                             text=True, timeout=10, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return sum(1 for line in out.stdout.splitlines() if "com.apple" in line)


def scan_outside(root, home, time_limit, stall_limit, progress=False):
    """Sizes of the OUTSIDE folders, other accounts by name only, local snapshots."""
    t0 = time.monotonic()
    found = {}
    for rel_text, description in OUTSIDE:
        rel = tuple(rel_text.split("/"))
        path = os.path.join(root, *rel)
        if os.path.isdir(path) and not os.path.islink(path):
            found[rel] = {"path": "/" + rel_text, "description": description, "bytes": 0,
                          "partial": False, "not_measured": 0, "children": {}}
    seen = set()

    def on_listing(rel, loc, msg):
        m = found[loc]
        if "self" in msg:
            m["bytes"] += msg["self"][1]
        if "err" in msg:
            if msg["err"] != "gone":
                m["not_measured"] += 1
                m["partial"] = True
            return {}
        subs, depth = {}, len(loc)
        for name, kind, size, _newest, link, _ in msg.get("e") or ():
            if kind == 2:
                continue
            if link:
                key = tuple(link)
                size = 0 if key in seen else size
                seen.add(key)
            m["bytes"] += size
            key = (rel + (name,))[depth]
            m["children"][key] = m["children"].get(key, 0) + size
            if kind == 1:
                subs[name] = loc
        if "f" in msg:
            m["bytes"] += msg["f"][0]
            key = rel[depth] if len(rel) > depth else "(files)"
            m["children"][key] = m["children"].get(key, 0) + msg["f"][0]
        return subs

    def on_no_answer(rel, loc, why, waited):
        if loc in found:
            found[loc]["not_measured"] += 1
            found[loc]["partial"] = True

    def on_skipped(parent, rows, why):
        for _rel, loc in rows:
            if loc in found:
                found[loc]["not_measured"] += 1
                found[loc]["partial"] = True

    cut, pending = walk(root, {rel: rel for rel in found}, on_listing, time_limit,
                        min(stall_limit, SIBLING_STALL_LIMIT), describe=True, skip_slow=False,
                        first_lim=UNIT_DEPTH, on_no_answer=on_no_answer,
                        on_skipped=on_skipped)
    for loc in pending.values():
        if loc in found:
            found[loc]["partial"] = True

    users = os.path.join(root, "Users")
    mine = os.path.basename(home) if os.path.dirname(home) == os.path.realpath(users) else None
    accounts = []
    try:
        with os.scandir(users) as it:  # names only: never look inside another account
            accounts = sorted(de.name for de in it if de.name not in ("Shared", mine)
                              and not de.name.startswith(".") and de.is_dir(follow_symlinks=False))
    except OSError:
        pass
    locations = []
    for m in sorted(found.values(), key=lambda m: -m["bytes"]):
        top = sorted(m.pop("children").items(), key=lambda kv: -kv[1])[:3]
        m["biggest_inside"] = [{"name": k, "bytes": v} for k, v in top if v > 0]
        locations.append(m)
    return {
        "scanned": True,
        "complete": not cut,
        "seconds": round(time.monotonic() - t0, 1),
        "bytes": sum(m["bytes"] for m in locations),
        "locations": locations,
        "other_accounts": accounts,
        "local_snapshots": _snapshot_count(root),
    }


def _record(it, home, now, nested=None):
    rec = _base_record(it, home, now)
    if it.entry is not UNKNOWN:
        return rec
    nested = nested or []
    by_kind, names = {}, {}
    for n in nested:
        by_kind[n.entry.kind] = by_kind.get(n.entry.kind, 0) + n.bytes
        names[n.rel[-1]] = names.get(n.rel[-1], 0) + n.bytes
    elsewhere = sum(by_kind.values())
    rec["whole_folder_bytes"] = it.bytes + elsewhere
    rec["counted_elsewhere"] = {
        "bytes": elsewhere,
        "by_kind": dict(sorted(by_kind.items(), key=lambda kv: -kv[1])),
        "names": [k for k, v in sorted(names.items(), key=lambda kv: -kv[1])[:3] if v > 0],
    }
    if rec["whole_folder_bytes"] >= BIG_UNKNOWN_BYTES:
        rec["biggest_inside"] = _inside_entries(it, it.grandchildren, 5)
    return rec


def _inside_entries(it, counts, top):
    """The biggest entries of a breakdown, with private folders as one entry each."""
    rows = [{"name": k, "bytes": v} for k, v in counts.items() if v > 0]
    rows += [{"name": "/".join(p.rel[len(it.rel):]), "bytes": p.bytes, "private": True}
             for p in it.private_children]
    return sorted(rows, key=lambda r: -r["bytes"])[:top]


def _base_record(it, home, now):
    if it.entry is PRIVATE:
        return {"rel": "/".join(it.rel), "path": os.path.join(home, *it.rel), "id": "private",
                "kind": "private", "bytes": it.bytes, "last_changed": None,
                "last_changed_epoch": None, "days_unchanged": None,
                "description": PRIVATE.description, "comes_back": RETURNS["no"],
                "protected": True, "partial": it.partial, "biggest_inside": []}
    return {
        "rel": "/".join(it.rel),
        "path": os.path.join(home, *it.rel),
        "id": it.entry.id,
        "kind": it.entry.kind,
        "bytes": it.bytes,
        "last_changed": iso(it.newest) if it.newest else None,
        "last_changed_epoch": it.newest,
        "days_unchanged": days_since(it.newest, now) if it.newest else None,
        "description": it.entry.description,
        "comes_back": RETURNS[it.entry.returns],
        "protected": it.entry.protected,
        "partial": it.partial,
        "biggest_inside": _inside_entries(it, it.children, 3),
    }


def _volume_used(home):
    """The data volume's own used space, as Finder counts it (APFS shares free space
    between the volumes of one container). None when macOS does not say."""
    try:
        env = dict(os.environ, LC_ALL="C")
        df = subprocess.run(["df", "-P", home], capture_output=True, text=True, timeout=10,
                            env=env, stdin=subprocess.DEVNULL)
        mount = df.stdout.splitlines()[1].split(None, 5)[5]
        info = subprocess.run(["diskutil", "info", "-plist", mount], capture_output=True,
                              timeout=10, stdin=subprocess.DEVNULL)
        used = plistlib.loads(info.stdout).get("CapacityInUse")
        return int(used) if used else None
    except (OSError, IndexError, ValueError, subprocess.SubprocessError, plistlib.InvalidFileException):
        return None


def disk_numbers(home, measured, not_measured_count, outside=None):
    """used (the data volume, else the whole disk) = home_measured + outside_measured
    + rest. Without an outside summary, rest is everything outside home too."""
    usage = shutil.disk_usage(home)
    volume_used = _volume_used(home)
    used = volume_used if volume_used is not None else usage.used
    return {
        "total": usage.total,
        "free": usage.free,
        "used": usage.used,
        "data_volume_used": volume_used,
        "home_measured": measured,
        "outside_measured": outside,
        "rest": max(0, used - measured - (outside or 0)),
        "system_and_other_volumes": (max(0, usage.used - volume_used)
                                     if volume_used is not None else None),
        "not_measured_count": not_measured_count,
        "note": ("Approximate. Free space here does not count purgeable space; Finder does, "
                 "so Finder can show more free space."),
    }


def _short(rel):
    """At most three folder names under home, for progress lines: never file names."""
    return disp("/".join(rel[:3])) + ("/..." if len(rel) > 3 else "")


def diff_scans(prev, cur):
    if prev is None:
        return {"since": None, "available": False, "reason": "first scan"}
    out = {"since": prev.get("scanned_at"), "since_epoch": prev.get("scanned_at_epoch")}
    if prev.get("timed_out", not prev.get("complete")) or cur.get("timed_out"):
        out.update(available=False, reason="one of the two scans stopped early at its time "
                                           "limit, so changes are not compared")
        return out
    blocked = [r["rel"] for r in cur.get("not_measured", [])]

    def hidden(rel):
        return any(rel == b or rel.startswith(b + "/") or b.startswith(rel + "/") for b in blocked)

    private = cur.get("private", [])
    before = {r["rel"]: r for r in prev.get("items", [])
              if not (_inside(r["rel"], private) and r["rel"] not in private)}
    after = {r["rel"]: r for r in cur["items"]}
    unseen = _not_measured_in(prev)
    new, grown, shrunk, newly = [], [], [], []
    kinds = {k: cur["kinds"][k] - prev.get("kinds", {}).get(k, 0) for k in KINDS}
    for rel, r in after.items():
        old = before.get(rel)
        row = {"rel": rel, "kind": r["kind"], "description": r["description"],
               "bytes": r["bytes"], "before": old["bytes"] if old else 0}
        row["change"] = row["bytes"] - row["before"]
        # Not measured (or only partly) last time: its size now is not a change.
        if (unseen(rel) if old is None else old.get("partial") and row["change"] > 0):
            row["last_time"] = "not measured" if old is None else "partly measured"
            kinds[r["kind"]] = kinds.get(r["kind"], 0) - row["change"]
            if row["change"] >= CHANGE_MIN_BYTES:
                newly.append(row)
        elif old is None:
            if r["bytes"] >= CHANGE_MIN_BYTES:
                new.append(row)
        elif row["change"] >= CHANGE_MIN_BYTES:
            grown.append(row)
        elif -row["change"] >= CHANGE_MIN_BYTES:
            shrunk.append(row)
    for rel, r in before.items():
        if rel not in after and r["bytes"] >= CHANGE_MIN_BYTES and not hidden(rel):
            shrunk.append({"rel": rel, "kind": r["kind"], "description": r["description"],
                           "bytes": 0, "before": r["bytes"], "change": -r["bytes"],
                           "gone": True})
    out.update(
        available=True,
        free_before=prev["disk"]["free"], free_now=cur["disk"]["free"],
        free_change=cur["disk"]["free"] - prev["disk"]["free"],
        kinds=kinds,
        new=sorted(new, key=lambda r: -r["change"]),
        grown=sorted(grown, key=lambda r: -r["change"]),
        shrunk=sorted(shrunk, key=lambda r: r["change"]),
        newly_measured=sorted(newly, key=lambda r: -r["change"]),
    )
    return out


def _not_measured_in(scan):
    """A test: was `rel` possibly left unmeasured by this (earlier) scan? Covers folders
    it could not read, folders it skipped, and areas it did not reach. A skipped row
    saved before the tool kept `names` covers its whole parent (unknown, so not "new")."""
    if "not_measured" not in scan and not scan.get("complete", False):
        return lambda rel: True
    areas, whole = [r["rel"] for r in scan.get("not_reached", [])], []
    for r in scan.get("not_measured", []):
        if not r["reason"].startswith("skipped"):
            areas.append(r["rel"])
        elif "names" in r:
            areas += [r["rel"] + "/" + n for n in r["names"]]
        else:
            whole.append(r["rel"])

    def test(rel):
        if any(a == "" or rel == a or rel.startswith(a + "/") for a in areas):
            return True
        return any(rel.startswith(w + "/") for w in whole)
    return test


def save_scan(home, result):
    folder = state_dir(home)
    latest = os.path.join(folder, "latest.json")
    if os.path.exists(latest):
        os.makedirs(folder, mode=0o700, exist_ok=True)
        os.replace(latest, os.path.join(folder, "previous.json"))
    _write_json(latest, result)


def scan_view(result, changes, top):
    """What `scan --json` prints: totals and the biggest items per kind."""
    kinds = {}
    for kind, label in KINDS.items():
        rows = [r for r in result["items"] if r["kind"] == kind]
        kinds[kind] = {
            "label": label,
            "bytes": result["kinds"][kind],
            "items": [_public(r) for r in rows if r["bytes"] >= LIST_MIN_BYTES][:top],
            "items_total": len(rows),
        }
    blocked = result["not_measured"]
    view = {k: v for k, v in result.items() if k not in ("items", "kinds", "not_measured")}
    view["outside"] = result.get("outside", {"scanned": False})
    view["kinds"] = kinds
    view["not_measured"] = [{k: v for k, v in r.items() if k != "names"}
                            for r in blocked[:NOT_MEASURED_TOP]]
    view["not_measured_total"] = len(blocked)
    if any(r["reason"] in ("privacy", "no-answer") for r in blocked):
        view["not_measured_hint"] = FDA_HINT
    trimmed = dict(changes)
    for key in ("new", "grown", "shrunk", "newly_measured"):
        if key in trimmed:
            trimmed[key] = trimmed[key][:top]
    view["changes"] = trimmed
    view["first_scan"] = changes.get("reason") == "first scan"
    return view


def _public(r):
    return {k: v for k, v in r.items() if not k.endswith("_epoch")}


FDA_HINT = ("To measure these, give your terminal app Full Disk Access: System Settings > "
            "Privacy & Security > Full Disk Access. Or leave them out; nothing else changes.")


def render_scan(result, changes):
    out = []
    head = f"Scanned {result['home']} in {_duration(result['seconds'])}."
    if not result["complete"]:
        head += " INCOMPLETE: " + result["incomplete_reason"] + "."
    out.append(head)
    out.extend(render_disk(result["disk"]))
    for kind, label in KINDS.items():
        rows = [r for r in result["items"]
                if r["kind"] == kind and r["bytes"] >= LIST_MIN_BYTES]
        out.append("")
        out.append(f"{label}: {fmt_bytes(result['kinds'][kind])}")
        for r in rows[:TEXT_TOP]:
            size = ("at least " if r["partial"] else "") + fmt_bytes(r["bytes"])
            out.append(f"  {size:>10}  {disp(r['rel'])}  {r['description']}")
            pad = f"  {'':>10}  "
            elsewhere = r.get("counted_elsewhere") or {}
            if elsewhere.get("bytes", 0) >= max(LIST_MIN_BYTES, 1):
                kinds = ", ".join(f"{k} {fmt_bytes(v)}" for k, v in elsewhere["by_kind"].items())
                out.append(f"{pad}the whole folder is {fmt_bytes(r['whole_folder_bytes'])}; "
                           f"{fmt_bytes(elsewhere['bytes'])} of it is counted above "
                           f"({kinds}: {', '.join(elsewhere['names'])})")
            shown = [c for c in r["biggest_inside"]  # "counted above" names private ones
                     if not (elsewhere.get("bytes") and c.get("private"))]
            if kind in ("user", "unknown") and shown:
                inside = ", ".join(f"{c['name']} {fmt_bytes(c['bytes'])}"
                                   + (" (private)" if c.get("private") else "")
                                   for c in shown)
                label = "the rest is mostly in" if elsewhere.get("bytes") else "biggest inside"
                out.append(f"{pad}{label}: {inside}")
        if len(rows) > TEXT_TOP:
            out.append(f"  ... and {len(rows) - TEXT_TOP} more")
    if result.get("not_reached"):
        out.append("")
        out.append("Not reached before the time limit (sizes there are missing or partial):")
        for r in result["not_reached"][:10]:
            out.append(f"  {disp(r['rel'])} ({r['status']})")
        if len(result["not_reached"]) > 10:
            out.append(f"  ... and {len(result['not_reached']) - 10} more")
    blocked = result["not_measured"]
    if blocked:
        out.append("")
        out.append("Not measured (never counted as empty):")
        for r in blocked[:8]:
            text = (_skipped_text(r["reason"], r["count"]) if r["reason"].startswith("skipped")
                    else NOT_MEASURED_TEXT[r["reason"]])
            out.append(f"  {disp(r['rel'])}: {text}")
        if len(blocked) > 8:
            out.append(f"  ... and {len(blocked) - 8} more")
        if any(r["reason"] in ("privacy", "no-answer") for r in blocked):
            out.append("  " + FDA_HINT)
    out.extend(render_outside(result.get("outside") or {}))
    out.append("")
    out.extend(render_changes(changes))
    return "\n".join(out)


def render_outside(o):
    if not o.get("scanned"):
        return []
    head = "Outside your home folder (sizes only; nothing here is ever cleaned)"
    if not o["complete"]:
        head += f", stopped after {_duration(o['seconds'])}: sizes are at least these"
    out = ["", head + ":"]
    for m in o["locations"]:
        if m["bytes"] < LIST_MIN_BYTES and not m["not_measured"]:
            continue
        size = ("at least " if m["partial"] else "") + fmt_bytes(m["bytes"])
        out.append(f"  {size:>10}  {m['path']}  {m['description']}")
        extra = []
        if m["biggest_inside"]:
            extra.append("biggest inside: " + ", ".join(
                f"{c['name']} {fmt_bytes(c['bytes'])}" for c in m["biggest_inside"]))
        if m["not_measured"]:
            extra.append(f"{m['not_measured']} folder{'s' if m['not_measured'] != 1 else ''} "
                         "your account may not read")
        for line in extra:
            out.append(f"  {'':>10}  {line}")
    for name in o["other_accounts"]:
        out.append(f"  another account: {name} (not measured: only that account can look)")
    if o.get("local_snapshots") is not None:
        out.append(f"  Local Time Machine snapshots: {o['local_snapshots']} (macOS removes "
                   "them by itself when space runs low)")
    return out


def render_disk(d):
    lines = [f"Disk: {fmt_bytes(d['total'])}, {fmt_bytes(d['free'])} free "
             "(Finder may show more free: it also counts purgeable space)."]
    used = d["data_volume_used"] if d.get("data_volume_used") is not None else d["used"]
    where = "Your data uses" if d.get("data_volume_used") is not None else "Used"
    missing = d.get("not_measured_count", 0)
    folders = f"{missing} folder{'s' if missing != 1 else ''} not measured"
    if d.get("outside_measured") is None:
        tail = f" or in the {folders}" if missing else ""
        lines.append(f"{where} {fmt_bytes(used)}: {fmt_bytes(d['home_measured'])} measured in "
                     f"your home folder, {fmt_bytes(d['rest'])} outside it (apps, macOS data, "
                     f"other user accounts){tail}.")
    else:
        lines.append(f"{where} {fmt_bytes(used)} = {fmt_bytes(d['home_measured'])} in your home "
                     f"folder + {fmt_bytes(d['outside_measured'])} in the folders outside it "
                     f"listed below + {fmt_bytes(d['rest'])} not measured (other accounts, "
                     f"system data your account may not read"
                     + (f", the {folders}" if missing else "") + ").")
    if d.get("system_and_other_volumes"):
        lines.append(f"macOS itself, swap and snapshots use another "
                     f"{fmt_bytes(d['system_and_other_volumes'])}.")
    return lines


def render_changes(ch):
    if ch.get("since") is None:
        return ["First scan: the next one will show what changed."]
    lines = [f"Since the last scan ({when(ch['since_epoch'])}):"]
    if not ch.get("available"):
        return lines + ["  " + ch["reason"] + "."]
    lines.append(f"  Free space: {fmt_bytes(ch['free_before'])} -> {fmt_bytes(ch['free_now'])}"
                 f" ({fmt_bytes(ch['free_change'], sign=True)})")
    for key, label in (("new", "new"), ("grown", "grew"), ("shrunk", "shrank")):
        for r in ch[key][:TEXT_TOP]:
            lines.append(f"  {label:<6} {fmt_bytes(r['change'], sign=True):>10}  {disp(r['rel'])}"
                         f"  ({r['kind']}, now {fmt_bytes(r['bytes'])})")
    if not (ch["new"] or ch["grown"] or ch["shrunk"]):
        lines.append(f"  Nothing changed by more than {fmt_bytes(CHANGE_MIN_BYTES)}.")
    newly = ch.get("newly_measured") or []
    if newly:
        lines.append("  Measured now, skipped last time (not a change, so not counted above):")
        for r in newly[:TEXT_TOP]:
            last = ("not measured" if r["last_time"] == "not measured"
                    else f"only partly measured, at least {fmt_bytes(r['before'])}")
            lines.append(f"    {fmt_bytes(r['bytes']):>10}  {disp(r['rel'])}"
                         f"  ({r['kind']}; last time {last})")
        if len(newly) > TEXT_TOP:
            lines.append(f"    ... and {len(newly) - TEXT_TOP} more")
    return lines


def _duration(seconds):
    if seconds < 10 and seconds != int(seconds):
        return f"{seconds:.1f} s"
    seconds = int(round(seconds))
    if seconds < 60:
        return f"{seconds} s"
    return f"{seconds // 60} min" + (f" {seconds % 60} s" if seconds % 60 else "")


def scan_and_save(args, home, progress):
    """One scan as `scan` and `watch` run it: measure, compare with the saved scan, save.
    Returns (previous scan or None, this scan, changes between them)."""
    prev = latest_scan(home)
    result = scan_home(home, args.time_limit, args.stall_limit, progress=progress,
                       root=outside_root(args.home is not None or ENV_HOME in os.environ))
    changes = diff_scans(prev, result)
    save_scan(home, result)
    return prev, result, changes


def cmd_scan(args, home):
    if not args.json:
        print(f"Scanning {home} (sizes only; stops after {_duration(args.time_limit)} at most)",
              file=sys.stderr, flush=True)
    _prev, result, changes = scan_and_save(args, home, progress=not args.json)
    if args.json:
        print(json.dumps(scan_view(result, changes, JSON_TOP), indent=2, ensure_ascii=False))
    else:
        print(render_scan(result, changes))
    return 0


# ----------------------------------------------------------------------------- watch

GB = 1000 * MB  # the same unit the reports print
WATCH_MIN_FREE_GB = 40  # alert when free space is below this
WATCH_MAX_DROP_GB = 5  # alert when free space dropped by more than this since the last scan
WATCH_MAX_ITEM_GROWTH_GB = 3  # alert when one item grew (or appeared) by more than this
WATCH_LOG_TOP = 20  # changed items kept per change-log line, biggest first
WATCH_CAUSES = 5  # causes named in an alert
WATCH_LOG_SHOW = 10  # entries `watch --log` prints by default
ALERT_EXIT = 3
CHANGE_WORDS = {"new": "new", "grown": "grew", "shrunk": "shrank", "gone": "gone"}


def change_log_path(home):
    return os.path.join(state_dir(home), "changes.jsonl")


def _log_rows(changes, private):
    """The changed items of one comparison, biggest change first: path, kind and change
    only. A private folder is one row (its total); nothing inside one is ever a row."""
    rows = []
    for key in ("new", "grown", "shrunk"):
        for r in changes.get(key) or []:
            if _inside(r["rel"], private) not in (None, r["rel"]):
                continue
            what = "gone" if r.get("gone") else key
            rows.append({"change": CHANGE_WORDS[what], "path": disp(r["rel"]),
                         "kind": r["kind"], "delta": r["change"], "bytes": r["bytes"]})
    rows.sort(key=lambda r: -abs(r["delta"]))
    return rows


def watch_entry(prev, cur, changes, limits):
    """One change-log line, with the alert decision. limits: bytes, by name."""
    free_now = cur["disk"]["free"]
    free_before = prev["disk"]["free"] if prev and prev.get("disk") else None
    rows = _log_rows(changes, cur.get("private", [])) if changes.get("available") else []
    reasons = []
    if free_now < limits["min_free"]:
        reasons.append(f"free space {fmt_bytes(free_now)} is below "
                       f"{fmt_bytes(limits['min_free'])}")
    if free_before is not None and free_before - free_now > limits["max_drop"]:
        reasons.append(f"free space dropped by {fmt_bytes(free_before - free_now)} "
                       f"(more than {fmt_bytes(limits['max_drop'])})")
    for r in rows:
        if r["delta"] > limits["max_item_growth"]:
            verb = "appeared with" if r["change"] == "new" else "grew by"
            reasons.append(f"{r['path']} {verb} {fmt_bytes(r['delta'])} "
                           f"(more than {fmt_bytes(limits['max_item_growth'])})")
    note = None
    if prev is None:
        note = "first run: baseline"
    elif not changes.get("available"):
        note = changes.get("reason")
    return {
        "at": cur["scanned_at"],
        "at_epoch": cur["scanned_at_epoch"],
        "since": prev.get("scanned_at") if prev else None,
        "since_epoch": prev.get("scanned_at_epoch") if prev else None,
        "baseline": prev is None,
        "complete": cur["complete"],
        "compared": bool(changes.get("available")),
        "note": note,
        "free_before": free_before,
        "free_now": free_now,
        "free_change": free_now - free_before if free_before is not None else None,
        "items": rows[:WATCH_LOG_TOP],
        "items_total": len(rows),
        "alert": bool(reasons),
        "reasons": reasons,
    }


def append_change_log(home, entry):
    path = change_log_path(home)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def read_change_log(home):
    """All entries, oldest first. Lines that do not parse are skipped."""
    try:
        with open(change_log_path(home)) as f:
            lines = f.readlines()
    except FileNotFoundError:
        return None
    entries = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict):
            entries.append(entry)
    return entries


def scrub_change_log(home, folder):
    """Remove change-log rows inside a folder that has just become private."""
    entries = read_change_log(home)
    if not entries:
        return
    for e in entries:
        e["items"] = [r for r in e.get("items", [])
                      if _inside(r.get("path", "")[2:], [folder]) in (None, folder)]
        # the reasons name item paths, so drop those that point inside the folder
        e["reasons"] = [t for t in e.get("reasons", [])
                        if not t.startswith(disp(folder) + "/")]
    path = change_log_path(home)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for e in entries:
            f.write(json.dumps(e, ensure_ascii=False) + "\n")
    os.replace(tmp, path)


def _free_text(e):
    if e.get("free_before") is None:
        return f"{fmt_bytes(e['free_now'])} free"
    return (f"free {fmt_bytes(e['free_before'])} -> {fmt_bytes(e['free_now'])} "
            f"({fmt_bytes(e['free_change'], sign=True)})")


def _cap(text):
    return text[:1].upper() + text[1:]


def _causes(e):
    return [r for r in e.get("items", []) if r["delta"] > 0][:WATCH_CAUSES]


def render_alert(e, log_path):
    since = f" since {when(e['since_epoch'])}" if e.get("since_epoch") else ""
    out = [f"{NAME} watch: ALERT. {_cap(_free_text(e))}{since}.",
           "Why: " + "; ".join(e["reasons"]) + "."]
    causes = _causes(e)
    if causes:
        out.append("Biggest causes:")
        for r in causes:
            out.append(f"  {fmt_bytes(r['delta'], sign=True):>10}  {r['path']}"
                       f"  ({r['kind']}, {r['change']}, now {fmt_bytes(r['bytes'])})")
    elif e.get("baseline"):
        out.append("First run: the next run shows what changed.")
    elif e.get("compared"):
        text = (f"Nothing in the home folder grew by more than {fmt_bytes(CHANGE_MIN_BYTES)}"
                " since the last scan")
        if (e.get("free_change") or 0) < -CHANGE_MIN_BYTES:
            text += ": the space went outside it (apps, system data, other accounts)"
        out.append(text + ".")
    elif e.get("note"):
        out.append(f"Not compared item by item: {e['note']}.")
    out.append(f"Logged in {log_path}; `{NAME} watch --log` shows the history.")
    return "\n".join(out)


def notify(title, message):
    """A macOS notification through osascript. Fails soft: returns False, never raises."""
    def quote(text):
        return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
    try:
        osascript = shutil.which("osascript")
        if not osascript:
            return False
        script = f"display notification {quote(message)} with title {quote(title)}"
        done = subprocess.run([osascript, "-e", script], capture_output=True, timeout=15,
                              stdin=subprocess.DEVNULL)
        return done.returncode == 0
    except Exception:  # a notification is never worth a failed watch
        return False


def _notification_text(e):
    text = _cap(_free_text(e)) + "."
    causes = _causes(e)
    if causes:
        text += " Biggest: " + ", ".join(f"{r['path']} {fmt_bytes(r['delta'], sign=True)}"
                                         for r in causes[:2]) + "."
    return text


def render_log(entries, n):
    shown = entries[-n:] if n > 0 else []
    out = [f"Disk change log: the last {len(shown)} of {len(entries)} run"
           f"{'s' if len(entries) != 1 else ''}, newest first."]
    for e in reversed(shown):
        head = f"{when(e['at_epoch'])}  {_free_text(e)}"
        if e.get("baseline"):
            head += "  (first run: baseline)"
        if e.get("alert"):
            head += "  ALERT: " + "; ".join(e.get("reasons", []))
        out.append("")
        out.append(head)
        if e.get("note") and not e.get("baseline"):
            out.append(f"    not compared item by item: {e['note']}")
        for r in e.get("items", []):
            out.append(f"    {r['change']:<6} {fmt_bytes(r['delta'], sign=True):>10}  "
                       f"{r['path']}  ({r['kind']}, now {fmt_bytes(r['bytes'])})")
        more = e.get("items_total", 0) - len(e.get("items", []))
        if more > 0:
            out.append(f"    ... and {more} smaller change{'s' if more != 1 else ''}")
        if e.get("compared") and not e.get("items"):
            out.append(f"    nothing changed by more than {fmt_bytes(CHANGE_MIN_BYTES)}")
    return "\n".join(out)


def cmd_watch(args, home):
    if args.log is not None:
        entries = read_change_log(home)
        if not entries:
            print(f"No change log yet. `{NAME} watch` writes one line per run.")
            return 1
        print(render_log(entries, args.log))
        return 0
    limits = {"min_free": args.min_free_gb * GB, "max_drop": args.max_drop_gb * GB,
              "max_item_growth": args.max_item_growth_gb * GB}
    for flag, value in (("--min-free-gb", args.min_free_gb), ("--max-drop-gb", args.max_drop_gb),
                        ("--max-item-growth-gb", args.max_item_growth_gb)):
        if value < 0:
            raise PolicyError(f"{flag} must be 0 or more")
    prev, result, changes = scan_and_save(args, home, progress=False)
    entry = watch_entry(prev, result, changes, limits)
    append_change_log(home, entry)
    if not entry["alert"]:
        if entry["baseline"]:
            print(f"{NAME} watch: first run, baseline saved; {_free_text(entry)}. No alert.")
        else:
            n = entry["items_total"]
            print(f"{NAME} watch: {_free_text(entry)} since {when(entry['since_epoch'])}; "
                  f"{n} change{'s' if n != 1 else ''} logged. No alert.")
        return 0
    print(render_alert(entry, change_log_path(home)))
    if not args.no_notify:
        try:
            notify(f"{NAME}: disk space", _notification_text(entry))
        except Exception:  # notify() never raises; this guards a replaced one too
            pass
    return ALERT_EXIT


# ----------------------------------------------------------------------------- policy

ACTIONS = ("keep", "ask", "clean")
POLICY_ABOUT = (
    "Cleaning rules. keep = never touch. ask = list it so you decide. clean = remove when "
    "nothing in it changed for older_than_days (only when you run clean --apply). "
    "'items' (catalog ids) override 'kinds'. 'user' and 'unknown' can never be clean.")


class PolicyError(Exception):
    pass


def default_policy():
    kinds = {k: {"action": "ask"} for k in KINDS}
    kinds["user"] = {"action": "keep"}
    kinds["private"] = {"action": "keep"}
    items = {e.id: {"action": "clean", "older_than_days": DEFAULT_CLEAN_DAYS}
             for e in CATALOG if e.auto_clean}
    return {"about": POLICY_ABOUT, "kinds": kinds, "items": items}


def _check_rule(name, rule, kind, protected):
    if not isinstance(rule, dict) or rule.get("action") not in ACTIONS:
        raise PolicyError(f"'{name}' needs an action: one of {', '.join(ACTIONS)}")
    if rule["action"] == "clean":
        if kind in NEVER_CLEAN:
            raise PolicyError(f"'{name}' is '{kind}', which can never be clean")
        if protected:
            raise PolicyError(f"'{name}' is never removed by this tool: {ENTRIES[name].description}")
        days = rule.get("older_than_days")
        if not isinstance(days, int) or isinstance(days, bool) or days < 0:
            raise PolicyError(f"'{name}' is clean, so it needs older_than_days (0 or more)")


def validate_policy(data):
    if not isinstance(data, dict):
        raise PolicyError("the file must hold a JSON object")
    kinds = data.get("kinds", {})
    items = data.get("items", {})
    if not isinstance(kinds, dict) or not isinstance(items, dict):
        raise PolicyError("'kinds' and 'items' must be objects")
    for kind, rule in kinds.items():
        if kind not in KINDS:
            raise PolicyError(f"unknown kind '{kind}'; kinds are {', '.join(KINDS)}")
        _check_rule(kind, rule, kind, False)
    warnings = []
    for item_id, rule in items.items():
        entry = ENTRIES.get(item_id)
        if entry is None:
            warnings.append(f"policy: '{item_id}' is not in the catalog any more; ignored")
            continue
        _check_rule(item_id, rule, entry.kind, entry.protected)
    return warnings


def load_policy(home, required=True):
    path = policy_path(home)
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        if required:
            raise PolicyError(f"no policy yet; `{NAME} policy init` writes the defaults")
        return None
    except ValueError as exc:
        raise PolicyError(f"{path} is not valid JSON: {exc}")
    for warning in validate_policy(data):
        print(warning, file=sys.stderr)
    return data


def rule_for(policy, entry):
    """The rule that applies to a catalog entry: its own, else its kind's, else ask."""
    rule = policy.get("items", {}).get(entry.id) or policy.get("kinds", {}).get(entry.kind)
    rule = dict(rule or {"action": "ask"})
    if entry.kind in NEVER_CLEAN or entry.protected:
        if rule["action"] == "clean":  # belt and braces: validate_policy already refuses it
            rule = {"action": "ask"}
    return rule


def _rule_text(rule):
    if rule["action"] == "clean":
        return f"clean when unused {rule['older_than_days']} days"
    return rule["action"]


def cmd_policy(args, home):
    path = policy_path(home)
    if args.policy_cmd == "init":
        if os.path.exists(path) and not args.force:
            print(f"{path} already exists; nothing changed. Use --force to replace it "
                  "with the defaults.")
            return 1
        _write_json(path, default_policy())
        print(f"Wrote the default policy to {path}.")
        print("Caches that rebuild themselves: clean when unused 30 days. "
              "Your files: keep. Everything else: ask.")
        return 0
    if args.policy_cmd == "set":
        target, action = args.target, args.action
        policy = load_policy(home, required=False)
        created = policy is None
        policy = policy or default_policy()
        rule = {"action": action}
        if action == "clean":
            rule["older_than_days"] = (args.older_than_days if args.older_than_days is not None
                                       else DEFAULT_CLEAN_DAYS)
        if target in KINDS:
            _check_rule(target, rule, target, False)
            policy.setdefault("kinds", {})[target] = rule
        elif target in ENTRIES and target not in ("unknown", "private"):
            entry = ENTRIES[target]
            _check_rule(target, rule, entry.kind, entry.protected)
            policy.setdefault("items", {})[target] = rule
        else:
            raise PolicyError(f"'{target}' is not a kind or a catalog id; "
                              f"see `{NAME} policy show --all`")
        validate_policy(policy)
        _write_json(path, policy)
        note = " (the file did not exist, so it starts from the defaults)" if created else ""
        print(f"{target}: {_rule_text(rule)}. Saved to {path}{note}.")
        return 0
    # show
    policy = load_policy(home, required=False)
    saved = policy is not None
    policy = policy or default_policy()
    if args.json:
        print(json.dumps({"path": path, "saved": saved, "policy": policy,
                          "catalog": [e._asdict() for e in ENTRIES.values()] if args.all else None},
                         indent=2, ensure_ascii=False))
        return 0
    print(f"Policy file: {path}" + ("" if saved else
          f"  (not saved yet: these are the defaults; `{NAME} policy init` writes them)"))
    print()
    print("By kind:")
    for kind in KINDS:
        rule = policy.get("kinds", {}).get(kind, {"action": "ask"})
        print(f"  {kind:<8} {_rule_text(rule):<28} {KINDS[kind]}")
    print()
    print("By item (these override the kind):")
    for item_id, rule in policy.get("items", {}).items():
        entry = ENTRIES.get(item_id)
        where = entry.pattern if entry else "(not in the catalog)"
        print(f"  {item_id:<22} {_rule_text(rule):<28} ~/{where}")
    if args.all:
        print()
        print("Every catalog item (id, kind, where, what it is):")
        for e in ENTRIES.values():
            if e is UNKNOWN or e is PRIVATE:
                continue
            flag = "  [never removed by this tool]" if e.protected else ""
            print(f"  {e.id:<22} {e.kind:<6} ~/{e.pattern}  {e.description}"
                  f" ({RETURNS[e.returns]}){flag}")
    print()
    print("keep = never touch. ask = list it so you decide. clean = remove when nothing in it "
          "changed for N days, only when you run `clean --apply`.")
    if not args.all:
        print(f"All item ids: `{NAME} policy show --all`.")
    return 0


# ----------------------------------------------------------------------------- private

PRIVATE_ABOUT = ("Private folders: the tool measures each one's total size and never lists, "
                 "records or cleans anything inside it. Paths are under your home folder. "
                 f"Change with `{NAME} private add|remove`.")


def _private_rel(home, arg):
    """A path the user typed -> "a/b" under home. ~/x, /abs/x and x (from home) work."""
    if arg == "~" or arg.startswith("~/"):
        path = os.path.join(home, arg[2:])
    elif os.path.isabs(arg):
        path = arg
    else:
        path = os.path.join(home, arg)
    path = os.path.normpath(path)
    rel = os.path.relpath(path, home)
    if rel == "." or rel == ".." or rel.startswith(".." + os.sep) or os.path.isabs(rel):
        raise PolicyError("a private folder must be inside your home folder, and not the "
                          "home folder itself")
    return rel.replace(os.sep, "/")


def scrub_saved(home, folder):
    """Remove what earlier scans recorded inside a folder that has just become private."""
    state = state_dir(home)
    for name in ("latest.json", "previous.json"):
        path = os.path.join(state, name)
        data = _read_json(path)
        if not data:
            continue
        kept = []
        for r in data.get("items", []):
            if r["rel"].startswith(folder + "/"):
                continue
            if r["rel"] == folder or folder.startswith(r["rel"] + "/"):
                base = r["rel"]
                r["biggest_inside"] = [c for c in r.get("biggest_inside", [])
                                       if not _inside(base + "/" + c["name"], [folder])
                                       or base + "/" + c["name"] == folder]
                if r["rel"] == folder:
                    r["biggest_inside"] = []
                if r.get("counted_elsewhere"):
                    r["counted_elsewhere"]["names"] = []
            kept.append(r)
        data["items"] = kept
        data["not_measured"] = [r for r in data.get("not_measured", [])
                                if not r["rel"].startswith(folder + "/")]
        for r in data["not_measured"]:
            if r["rel"] == folder:
                r.pop("names", None)  # names inside it; without them the whole is unknown
        data["not_reached"] = [r for r in data.get("not_reached", [])
                               if not r["rel"].startswith(folder + "/")]
        _write_json(path, data)
    scrub_change_log(home, folder)
    plan = os.path.join(state, "clean-plan.json")
    if os.path.exists(plan):
        os.unlink(plan)


def cmd_private(args, home):
    path = private_path(home)
    folders = load_private(home)
    if args.private_cmd == "list":
        if not folders:
            print(f"No private folders. Add one with `{NAME} private add <path>`.")
        for f in folders:
            print(disp(f))
        return 0
    rel = _private_rel(home, args.path)
    if args.private_cmd == "add":
        if rel in folders:
            print(f"{disp(rel)} is already private.")
            return 0
        folders.append(rel)
        _write_json(path, {"about": PRIVATE_ABOUT, "folders": sorted(folders)})
        scrub_saved(home, rel)
        note = "" if os.path.isdir(os.path.join(home, rel)) else " (it does not exist yet)"
        print(f"{disp(rel)} is private{note}: scans show only its total size, and nothing "
              "inside it is ever listed, saved or cleaned.")
        return 0
    if rel not in folders:
        print(f"{disp(rel)} was not private.")
        return 1
    folders.remove(rel)
    _write_json(path, {"about": PRIVATE_ABOUT, "folders": folders})
    print(f"{disp(rel)} is no longer private; the next scan lists what is inside it.")
    return 0


# ----------------------------------------------------------------------------- clean

def measure_many(home, rels, time_limit, stall_limit):
    """Size, newest change and git folders of items, read by the child walker."""
    deadline = time.monotonic() + time_limit
    res = {r: {"bytes": 0, "newest": 0.0, "unreadable": False, "mount": False,
               "timeout": False, "missing": False, "link": False, "no_answer": False,
               "git": []} for r in rels}
    seen = {r: set() for r in rels}
    todo = sorted(set(rels))
    while todo:
        # An item inside another item is measured in a later round, on its own.
        batch = [r for r in todo if not any(o != r and r[:len(o)] == o for o in todo)]
        todo = [r for r in todo if r not in batch]

        def on_listing(rel, root, msg):
            m = res[root]
            if "self" in msg:
                kind, size, newest = msg["self"]
                m["bytes"] += size
                m["newest"] = max(m["newest"], newest)
                m["link"] = m["link"] or kind == "link"
                m["mount"] = m["mount"] or kind == "other-disk"
            if "err" in msg:
                if msg["err"] != "gone":
                    m["unreadable"] = True
                elif rel == root:
                    m["missing"] = True
                return {}
            subs = {}
            for name, kind, size, newest, link, _markers in msg.get("e") or ():
                if name == ".git":
                    m["git"].append(os.path.join(home, *rel))
                if kind == 2:
                    m["mount"] = True
                    continue
                if link:
                    key = tuple(link)
                    size = 0 if key in seen[root] else size
                    seen[root].add(key)
                m["bytes"] += size
                m["newest"] = max(m["newest"], newest)
                if kind == 1:
                    subs[name] = root
            if "f" in msg:
                m["bytes"] += msg["f"][0]
                m["newest"] = max(m["newest"], msg["f"][1])
            return subs

        def on_no_answer(rel, root, why, _waited):
            res[root]["no_answer" if why == "no-answer" else "unreadable"] = True

        def on_skipped(_parent, rows, _why):
            for _rel, root in rows:
                res[root]["no_answer"] = True

        timed_out, _pending = walk(home, {r: r for r in batch}, on_listing,
                                   max(0.0, deadline - time.monotonic()), stall_limit,
                                   describe=True, skip_slow=False, on_no_answer=on_no_answer,
                                   on_skipped=on_skipped)
        if timed_out:
            for r in batch + todo:
                res[r]["timeout"] = True
            break
    return res


def check_path(home, path):
    """Why this path must not be removed, or None. Re-checked right before removal."""
    home = os.path.realpath(home)
    rel = os.path.relpath(path, home)
    if os.path.isabs(rel) or rel == "." or rel.startswith(".." + os.sep) or rel == "..":
        return "outside your home folder"
    if len(rel.split(os.sep)) < 2:
        return "a top-level folder of your home; never removed"
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return "already gone"
    if stat.S_ISLNK(st.st_mode):
        target = os.path.realpath(path)
        if not target.startswith(home + os.sep):
            return "a link pointing outside your home folder"
        return "a link, not the folder itself"
    if os.path.realpath(path) != os.path.join(home, rel):
        return "reached through a link"
    return None


def _git(repo, *argv):
    # The repo may sit inside a downloaded cache, so switch off what its own config
    # could make git run, and any network transport.
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", LC_ALL="C")
    hardening = ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
                 "-c", "core.untrackedCache=false", "-c", "protocol.allow=never"]
    try:
        proc = subprocess.run(["git"] + hardening + ["-C", repo] + list(argv),
                              capture_output=True,
                              text=True, env=env, timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return proc.stdout if proc.returncode == 0 else None


def git_check(home, path, git_dirs):
    """Refuse git projects with unsaved work inside the item, and files git tracks."""
    for repo in git_dirs:
        name = disp(os.path.relpath(repo, home))
        status = _git(repo, "status", "--porcelain")
        if status is None:
            return f"git project {name} could not be checked"
        if status.strip():
            return f"git project {name} has uncommitted changes"
        unpushed = _git(repo, "log", "--branches", "--not", "--remotes", "--oneline", "-n", "1")
        if unpushed is None or unpushed.strip():
            return f"git project {name} has commits that are not pushed"
        stashes = _git(repo, "stash", "list")
        if stashes is None or stashes.strip():
            return f"git project {name} has stashed changes"
    parent = os.path.dirname(path)
    while True:
        if os.path.lexists(os.path.join(parent, ".git")):
            tracked = _git(parent, "ls-files", "-z", "--", os.path.relpath(path, parent))
            if tracked is None:
                return "inside a git project that could not be checked"
            if tracked:
                return "git tracks files in it"
            break
        if parent == home or os.path.dirname(parent) == parent:
            break
        parent = os.path.dirname(parent)
    return None


def build_plan(home, scan, policy, only, time_limit, stall_limit=None):
    """Rows of what `clean` would remove (remove=True) and what it leaves, with reasons."""
    now = _now()
    stall_limit = STALL_LIMIT if stall_limit is None else stall_limit
    private = sorted(set(load_private(home)) | set(scan.get("private", [])))
    records = {r["rel"]: r for r in scan["items"]
               if not (_inside(r["rel"], private) and r["kind"] != "private")}
    rules = {}

    def rule(rec):
        if rec["rel"] not in rules:
            entry = ENTRIES.get(rec["id"], UNKNOWN)
            rules[rec["rel"]] = (entry, rule_for(policy, entry))
        return rules[rec["rel"]]

    targets, recent = [], {"count": 0, "bytes": 0}
    if only:
        for rel in only:
            folder = _inside(rel, private)
            if folder:
                raise PolicyError(f"{disp(folder)} is private: nothing inside it is ever "
                                  "cleaned")
            if rel not in records:
                raise PolicyError(f"{disp(rel)} is not an item from the last scan; "
                                  f"use a path as `scan` shows it")
            targets.append(records[rel])
    else:
        for rec in records.values():
            entry, r = rule(rec)
            if r["action"] != "clean":
                continue
            if days_since(rec["last_changed_epoch"] or now, now) < r["older_than_days"]:
                recent["count"] += 1
                recent["bytes"] += rec["bytes"]
                continue
            targets.append(rec)
    targets.sort(key=lambda r: -r["bytes"])
    rows, to_measure = [], []
    for rec in targets:
        entry, r = rule(rec)
        path = os.path.join(home, *rec["rel"].split("/"))
        row = {"rel": rec["rel"], "path": path, "id": entry.id, "kind": entry.kind,
               "bytes": rec["bytes"], "description": entry.description,
               "comes_back": RETURNS[entry.returns], "rule": _rule_text(r),
               "days_unchanged": None, "remove": False, "reason": None}
        rows.append(row)
        reason = None
        if entry.kind == "user":
            reason = "your own files; never removed"
        elif entry.kind == "unknown":
            reason = "not in the catalog; never removed by this tool"
        elif entry.protected:
            reason = "never removed by this tool: " + entry.description
        elif r["action"] == "keep":
            reason = "your policy says keep"
        elif any(f.startswith(rec["rel"] + "/") for f in private):
            reason = "it holds a private folder"
        if reason is None:
            for other in records.values():
                if other["rel"].startswith(rec["rel"] + "/"):
                    o_entry, o_rule = rule(other)
                    if o_entry.kind in NEVER_CLEAN or o_entry.protected or (
                            o_rule["action"] != "clean" and not only) or o_rule["action"] == "keep":
                        reason = (f"it holds {disp(other['rel'])} ({o_entry.kind}), "
                                  f"which your policy does not clean")
                        break
        row["reason"] = reason
        if reason is None:
            to_measure.append(row)
    measured = measure_many(home, [tuple(r["rel"].split("/")) for r in to_measure],
                            time_limit, stall_limit)
    for row in to_measure:
        m = measured[tuple(row["rel"].split("/"))]
        r = rule(records[row["rel"]])[1]
        if m["no_answer"]:
            reason = "macOS did not answer while checking it (privacy prompt?)"
        elif m["timeout"]:
            reason = "ran out of time checking it"
        elif m["missing"]:
            reason = "already gone"
        else:
            reason = check_path(home, row["path"])
        if reason is None:
            row["bytes"] = m["bytes"]
            row["days_unchanged"] = days_since(m["newest"], now)
            if m["unreadable"]:
                reason = "could not look inside all of it"
            elif m["mount"]:
                reason = "another disk is mounted inside it"
            elif not only and row["days_unchanged"] < r["older_than_days"]:
                reason = f"changed {row['days_unchanged']} days ago"
            else:
                reason = git_check(home, row["path"], m["git"])
        row["reason"] = reason
    for row in rows:
        row["remove"] = row["reason"] is None
    return rows, recent


def _plan_file(home):
    return os.path.join(state_dir(home), "clean-plan.json")


def _trash_dest(trash, name):
    dest = os.path.join(trash, name)
    if not os.path.lexists(dest):
        return dest
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H.%M.%S")
    n = 0
    while True:
        dest = os.path.join(trash, f"{name} {stamp}" + (f" {n}" if n else ""))
        if not os.path.lexists(dest):
            return dest
        n += 1


def _delete(path):
    def retry(func, p, _exc):
        # A read-only folder (Go's module cache) blocks removal: make it writable and
        # try once more. Never chmod through a link.
        for target in (os.path.dirname(p), p):
            try:
                if not os.path.islink(target):
                    os.chmod(target, 0o700)
            except OSError:
                pass
        func(p)

    if os.path.isdir(path) and not os.path.islink(path):
        if sys.version_info >= (3, 12):
            shutil.rmtree(path, onexc=retry)
        else:
            shutil.rmtree(path, onerror=retry)
    else:
        os.unlink(path)


def remove_item(home, path, rel):
    """Move to the Trash when possible, otherwise delete. Returns what happened."""
    reason = check_path(home, path)
    if reason:
        return None, reason
    if rel.split("/")[0] != ".Trash":
        trash = os.path.join(home, ".Trash")
        try:
            os.makedirs(trash, mode=0o700, exist_ok=True)
            os.rename(path, _trash_dest(trash, os.path.basename(path)))
            return "moved to the Trash", None
        except OSError:
            pass
    try:
        _delete(path)
    except OSError as exc:
        return None, f"could not remove it: {exc.strerror or exc}"
    return "deleted", None


def cmd_clean(args, home):
    scan = latest_scan(home)
    if scan is None:
        print(f"No scan yet. Run `{NAME} scan` first.")
        return 1
    policy = load_policy(home, required=not args.path) or default_policy()
    only = [p[2:] if p.startswith("~/") else os.path.relpath(p, home) if os.path.isabs(p)
            else p for p in (args.path or [])]
    only = [p.rstrip("/") for p in only]
    rows, recent = build_plan(home, scan, policy, only, args.time_limit, args.stall_limit)
    plan_file = _plan_file(home)
    if not args.apply:
        _write_json(plan_file, {"home": home, "created_epoch": _now(),
                                "remove": [r["rel"] for r in rows if r["remove"]]})
        return _report_plan(args, scan, rows, recent)
    saved = _read_json(plan_file)
    if (not saved or saved.get("home") != home
            or _now() - saved.get("created_epoch", 0) > PLAN_MAX_AGE):
        print(f"Run `{NAME} clean` without --apply first, check its list, then apply "
              "within a day.")
        return 1
    shown = set(saved.get("remove", []))
    free_before = shutil.disk_usage(home).free
    done, skipped = [], []
    for row in rows:
        if not row["remove"]:
            continue
        if row["rel"] not in shown:
            row["reason"] = "was not in the dry run you checked"
            skipped.append(row)
            continue
        how, reason = remove_item(home, row["path"], row["rel"])
        if how:
            row["done"] = how
            done.append(row)
        else:
            row["reason"] = reason
            skipped.append(row)
    os.unlink(plan_file)
    free_after = shutil.disk_usage(home).free
    in_trash = sum(r["bytes"] for r in done if r["done"] == "moved to the Trash")
    if args.json:
        print(json.dumps({"applied": True, "removed": done, "skipped": skipped,
                          "free_before": free_before, "free_after": free_after,
                          "moved_to_trash_bytes": in_trash}, indent=2, ensure_ascii=False))
        return 0
    if done:
        print(f"Removed {len(done)} item{'s' if len(done) != 1 else ''}:")
        for r in done:
            print(f"  {r['done']:<19} {fmt_bytes(r['bytes']):>9}  {disp(r['rel'])}")
    else:
        print("Removed nothing.")
    if skipped:
        print("Skipped:")
        for r in skipped:
            print(f"  {disp(r['rel'])}: {r['reason']}")
    print(f"Free space: {fmt_bytes(free_before)} -> {fmt_bytes(free_after)} "
          f"({fmt_bytes(free_after - free_before, sign=True)}).")
    if in_trash:
        print(f"{fmt_bytes(in_trash)} is now in the Trash. Empty the Trash to get that space back.")
    return 0


def _report_plan(args, scan, rows, recent):
    keep = [r for r in rows if r["remove"]]
    left = [r for r in rows if not r["remove"]]
    total = sum(r["bytes"] for r in keep)
    if args.json:
        print(json.dumps({"applied": False, "scan_from": scan["scanned_at"],
                          "remove": keep, "remove_bytes": total, "left_alone": left,
                          "used_recently": recent}, indent=2, ensure_ascii=False))
        return 0
    print("Dry run: nothing is removed.")
    print(f"Based on the scan from {when(scan['scanned_at_epoch'])}.")
    print()
    if keep:
        print(f"Would remove {len(keep)} item{'s' if len(keep) != 1 else ''}, "
              f"{fmt_bytes(total)} in total:")
        for r in keep:
            print(f"  {fmt_bytes(r['bytes']):>9}  {disp(r['rel'])}  "
                  f"(unchanged {r['days_unchanged']} days; {r['comes_back']})")
    else:
        print("Nothing to remove.")
    if left:
        print()
        print("Left alone:")
        for r in left:
            print(f"  {disp(r['rel'])}: {r['reason']}")
    if recent["count"]:
        print()
        print(f"{recent['count']} more item{'s' if recent['count'] != 1 else ''} "
              f"({fmt_bytes(recent['bytes'])}) have a clean rule but changed recently; "
              "they stay.")
    if keep:
        extra = "".join(" --path " + shlex.quote(r["rel"]) for r in keep) if args.path else ""
        print()
        print(f"To remove exactly the {len(keep)} above: {NAME} clean{extra} --apply")
        print("Items go to the Trash (items already in the Trash are deleted).")
    return 0


# ----------------------------------------------------------------------------- explain

EXPLAIN = """\
How {name} works

What it does
  scan     Adds up how much space each folder in your home folder takes, and sorts it
           into six kinds:
             cache    rebuilds by itself: app caches, Xcode build files, npm, pip and
                      Homebrew downloads, browser caches
             temp     leftovers: the Trash, logs, old simulators, old iPhone debug files
             dev      project files a command brings back (node_modules, .venv, build
                      folders), developer tools, and Docker and other virtual disks
             apps     app data and settings in ~/Library
             user     your own files: Documents, Desktop, Downloads, Pictures, Movies, Music
             unknown  anything else that is big: you judge these
           It keeps the result, so the next scan can say what is new or has grown.
           It also adds up, read-only, the big folders outside your home folder
           (/Applications, /Library, /Users/Shared, /private/var, /opt, /usr/local),
           names other accounts without looking inside them, and counts local Time
           Machine snapshots. Nothing outside your home folder is ever cleaned.
  policy   One small file with your rules, per kind or per item: keep, ask, or clean
           when nothing in it changed for a number of days.
  clean    Lists exactly what your rules would remove and how much that frees.
           Nothing is removed until you run it again with --apply.
  private  Folders whose contents must never be named, such as an employer's code or
           client work: `{name} private add ~/Developer/Acme`. For each one the
           report shows only its path and total size. Nothing inside it is listed,
           saved, shown while scanning, or ever cleaned; adding one also removes what
           earlier saved scans recorded inside it.
  watch    For a schedule you set up yourself: scans, adds one line to a change log
           (free space then and now, the biggest items that are new, grew, shrank or
           are gone), and exits with code 3 and a macOS notification when free space
           is below {min_free} GB, dropped by more than {max_drop} GB, or one item grew by more
           than {max_item} GB (change these with --min-free-gb, --max-drop-gb, --max-item-growth-gb).
           `{name} watch --log` shows what changed and when.

What it never does
  - It never opens or reads your files: it looks at sizes and dates only.
  - It never uses the network and sends nothing anywhere.
  - It never removes your own files (user) or anything it does not recognise (unknown).
  - It never opens another account's folder, and never removes anything outside your
    home folder; it never follows links out of it,
    and never touches a git project with uncommitted or unpushed work.
  - It never runs by itself: there is no background job unless you set one up.

Where it keeps its files
  Your rules:  {policy}
  Private:     {private}
  Scans:       {state}
  Change log:  {changelog}
  The tool:    {tool}

How cleaning works
  1. `{name} clean` shows the list and the space it frees.
  2. `{name} clean --apply` removes only that list, checking each item again first and
     skipping anything that changed. Items go to the Trash when possible: empty the
     Trash to get the space back. Items already in the Trash are deleted.

Privacy prompts and time limits
  macOS may ask whether your terminal may access Documents, Desktop or other apps' data.
  While such a prompt waits, macOS holds the folder; if nobody answers within {stall},
  the tool skips that folder and goes on (folders next to it get {sibling}; after three
  in one folder it skips the rest of that folder; waiting never adds up to more than
  {budget} per scan). Folders macOS usually guards, and cloud drives, are scanned last. Folders macOS keeps closed or holds are shown
  as "not measured", never as empty. To measure them, give your terminal app Full Disk
  Access (System Settings > Privacy & Security).

A scan takes a few minutes, prints which folder it is in every few seconds (never file
names), and stops after {limit} at most, reporting what it measured and what it did
not reach. The disk line splits the used space into your home folder, the folders
outside it listed in the report, and the rest it could not measure (other accounts,
system data your account may not read).
"""


def cmd_explain(args, home):
    print(EXPLAIN.format(name=NAME, policy=policy_path(home), private=private_path(home),
                         state=state_dir(home), changelog=change_log_path(home),
                         min_free=WATCH_MIN_FREE_GB, max_drop=WATCH_MAX_DROP_GB,
                         max_item=WATCH_MAX_ITEM_GROWTH_GB,
                         tool=tool_dir(), limit=_duration(DEFAULT_TIME_LIMIT),
                         stall=_duration(STALL_LIMIT),
                         sibling=_duration(SIBLING_STALL_LIMIT),
                         budget=_duration(STALL_BUDGET)))
    last = latest_scan(home)
    if last is None:
        print("Last scan: never")
    else:
        state = "complete" if last.get("complete") else "incomplete"
        print(f"Last scan: {when(last['scanned_at_epoch'])} ({state})")
    return 0


# ----------------------------------------------------------------------------- main

def main(argv=None):
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--home", help=f"folder to treat as home (default: ~ or ${ENV_HOME})")
    parser = argparse.ArgumentParser(
        prog=NAME, description="See what fills your home folder, and clean what rebuilds itself.")
    parser.add_argument("--version", action="version", version=f"{NAME} {VERSION}")
    sub = parser.add_subparsers(dest="cmd", metavar="command")
    sub.required = True

    p = sub.add_parser("scan", parents=[common], help="measure the home folder")
    p.add_argument("--json", action="store_true", help="print JSON (for agents)")
    p.add_argument("--time-limit", type=float, default=DEFAULT_TIME_LIMIT, metavar="SECONDS",
                   help=f"stop and report after this long (default {DEFAULT_TIME_LIMIT})")
    p.add_argument("--stall-limit", type=float, default=STALL_LIMIT, metavar="SECONDS",
                   help="skip a folder macOS does not answer for this long (default "
                        f"{STALL_LIMIT}; a privacy prompt can hold a folder forever)")

    sub.add_parser("explain", parents=[common], help="how the tool works, in plain words")

    p = sub.add_parser("policy", parents=[common], help="show or change the cleaning rules")
    psub = p.add_subparsers(dest="policy_cmd", metavar="show|init|set")
    psub.required = True
    q = psub.add_parser("show", parents=[common], help="print the rules")
    q.add_argument("--all", action="store_true", help="also list every catalog item")
    q.add_argument("--json", action="store_true")
    q = psub.add_parser("init", parents=[common], help="write the safe defaults")
    q.add_argument("--force", action="store_true", help="replace an existing policy")
    q = psub.add_parser("set", parents=[common], help="set one rule")
    q.add_argument("target", help="a kind (cache, temp, dev, apps, user, unknown) or an item id")
    q.add_argument("action", choices=ACTIONS)
    q.add_argument("--older-than-days", type=int, metavar="DAYS",
                   help=f"for clean: unused this many days (default {DEFAULT_CLEAN_DAYS})")

    p = sub.add_parser("private", parents=[common],
                       help="folders whose contents are never listed (size only)")
    psub = p.add_subparsers(dest="private_cmd", metavar="add|remove|list")
    psub.required = True
    q = psub.add_parser("add", parents=[common], help="make a folder private")
    q.add_argument("path", help="~/Developer/Acme, an absolute path, or a path under home")
    q = psub.add_parser("remove", parents=[common], help="make a folder ordinary again")
    q.add_argument("path")
    psub.add_parser("list", parents=[common], help="show the private folders")

    p = sub.add_parser("clean", parents=[common],
                       help="list what the policy would remove; --apply removes it")
    p.add_argument("--apply", action="store_true", help="really remove the dry-run list")
    p.add_argument("--path", action="append", metavar="PATH",
                   help="only this item from the last scan (repeatable), whatever its rule "
                        "except keep")
    p.add_argument("--json", action="store_true")
    p.add_argument("--time-limit", type=float, default=DEFAULT_TIME_LIMIT, metavar="SECONDS")
    p.add_argument("--stall-limit", type=float, default=STALL_LIMIT, metavar="SECONDS",
                   help="skip a folder macOS does not answer for this long (default "
                        f"{STALL_LIMIT}; a privacy prompt can hold a folder forever)")

    p = sub.add_parser("watch", parents=[common],
                       help="scan, log what changed, alert when space runs low (for a schedule)")
    p.add_argument("--log", type=int, nargs="?", const=WATCH_LOG_SHOW, metavar="N",
                   help=f"print the last N change-log entries (default {WATCH_LOG_SHOW}); "
                        "no scan")
    p.add_argument("--min-free-gb", type=float, default=WATCH_MIN_FREE_GB, metavar="GB",
                   help=f"alert when free space is below this (default {WATCH_MIN_FREE_GB})")
    p.add_argument("--max-drop-gb", type=float, default=WATCH_MAX_DROP_GB, metavar="GB",
                   help="alert when free space dropped by more than this since the last "
                        f"scan (default {WATCH_MAX_DROP_GB})")
    p.add_argument("--max-item-growth-gb", type=float, default=WATCH_MAX_ITEM_GROWTH_GB,
                   metavar="GB", help="alert when one item grew or appeared by more than "
                                      f"this (default {WATCH_MAX_ITEM_GROWTH_GB})")
    p.add_argument("--no-notify", action="store_true",
                   help="no macOS notification on an alert (the exit code is still 3)")
    p.add_argument("--time-limit", type=float, default=DEFAULT_TIME_LIMIT, metavar="SECONDS",
                   help=f"stop and report after this long (default {DEFAULT_TIME_LIMIT})")
    p.add_argument("--stall-limit", type=float, default=STALL_LIMIT, metavar="SECONDS",
                   help="skip a folder macOS does not answer for this long (default "
                        f"{STALL_LIMIT}; a privacy prompt can hold a folder forever)")

    args = parser.parse_args(argv)
    home = resolve_home(args.home)
    handler = {"scan": cmd_scan, "explain": cmd_explain, "policy": cmd_policy,
               "clean": cmd_clean, "private": cmd_private, "watch": cmd_watch}[args.cmd]
    try:
        return handler(args, home)
    except PolicyError as exc:
        print(f"{NAME}: {exc}", file=sys.stderr)
        return 2


def _stop_on_sigterm(_signum, _frame):
    raise KeyboardInterrupt  # unwinds through walk(), which stops its child


if __name__ == "__main__":
    if sys.argv[1:2] == ["_walk"]:  # the child process of walk()
        try:
            sys.exit(walker_main(sys.argv[2]))
        except BrokenPipeError:  # the parent is gone
            os._exit(1)
    signal.signal(signal.SIGTERM, _stop_on_sigterm)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(f"{NAME}: stopped; nothing was saved.", file=sys.stderr)
        sys.exit(130)
