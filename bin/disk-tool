#!/usr/bin/env python3
"""See what fills your home folder, and clean what rebuilds itself.

One file, Python 3.9+ standard library only, made for macOS.
It looks at sizes and dates only: it never opens your files and never uses the network.
Run `explain` for the plain-words version.
"""

import argparse
import datetime
import errno
import fnmatch
import json
import os
import shutil
import stat
import subprocess
import sys
import time
from collections import namedtuple

NAME = "disk-tool"  # the product name lives here and only here
VERSION = "0.1.0"
ENV_HOME = NAME.upper().replace("-", "_") + "_HOME"  # measure another folder instead of ~

DEFAULT_TIME_LIMIT = 600  # seconds a scan may run before it reports what it has
DEFAULT_CLEAN_DAYS = 30
MB = 1000 * 1000
LIST_MIN_BYTES = 1 * MB  # smaller items are left out of the lists
CHANGE_MIN_BYTES = 100 * MB  # smaller changes between two scans are not reported
JSON_TOP = 15  # items per kind in `scan --json`
TEXT_TOP = 5  # items per kind in the text report
NOT_MEASURED_TOP = 30
PLAN_MAX_AGE = 24 * 3600  # `clean --apply` needs a dry run younger than this

_now = time.time  # tests replace it to make things look old


# ----------------------------------------------------------------------------- catalog

# The kinds, in report order.
KINDS = {
    "cache": "Cache: rebuilds by itself",
    "temp": "Temporary files and leftovers",
    "dev": "Developer files and tools",
    "apps": "App data and settings",
    "user": "Your files",
    "unknown": "Not in the catalog: you judge these",
}
NEVER_CLEAN = ("user", "unknown")

RETURNS = {
    "auto": "comes back by itself",
    "command": "a command brings it back",
    "no": "does not come back",
}

Entry = namedtuple("Entry", "id kind pattern returns description auto_clean protected")


def E(id, kind, pattern, returns, description, auto_clean=False, protected=False):
    return Entry(id, kind, pattern, returns, description, auto_clean, protected)


# One row per thing the tool recognises.
#   pattern     a path inside the home folder; `*` matches one name. The first part is
#               a plain name. When several rows match a path, the most specific wins;
#               a row deeper in the tree takes its bytes away from the row above it.
#   returns     auto | command | no: whether it comes back after removal (see RETURNS).
#   auto_clean  `policy init` proposes `clean` after 30 days unused. Caches only.
#   protected   never removed by this tool; the description says what to do instead.
