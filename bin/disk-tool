    "no": "does not come back",
}

Entry = namedtuple("Entry", "id kind pattern returns description auto_clean protected")


def E(id, kind, pattern, returns, description, auto_clean=False, protected=False):
    return Entry(id, kind, pattern, returns, description, auto_clean, protected)


# One row per thing the tool recognises.
#   pattern     a path inside the home folder; `*` matches one name. The first part is
#               a plain name. When several rows match a path, the most specific wins;
#               a row deeper in the tree takes its bytes away from the row above it.
#   returns     auto | command | no: whether it comes back after removal (see RETURNS).
#   auto_clean  `policy init` proposes `clean` after 30 days unused. Caches only.
#   protected   never removed by this tool; the description says what to do instead.
