NAME = "disk-tool"  # the product name lives here and only here
VERSION = "0.1.0"
ENV_HOME = NAME.upper().replace("-", "_") + "_HOME"  # measure another folder instead of ~

MB = 1000 * 1000
DEFAULT_TIME_LIMIT = 600  # seconds a scan may run before it reports what it has
STALL_LIMIT = 20  # seconds one folder may keep macOS silent before it is skipped
SIBLING_STALL_LIMIT = 5  # the same, for folders next to one that already stalled
STALLS_PER_PARENT = 3  # after this many stalls in one folder, skip the rest of it
STALL_BUDGET = 60  # seconds a whole scan may spend waiting on folders that do not answer
LATE_STALL_LIMIT = 2  # the stall limit once that budget is spent
WALKERS = 4  # child processes walking at the same time
FIRST_DEPTH = 2  # the first job lists home and two levels below it
UNIT_DEPTH = 3  # later jobs walk this many levels, then hand deeper folders back
UNITS_PER_JOB = 8
OUTSIDE_TIME_LIMIT = 60  # seconds for the summary of folders outside home
BIG_UNKNOWN_BYTES = 5 * 1000 * MB  # unknown folders this big get a two-level breakdown
PROGRESS_EVERY = 3  # seconds between progress lines on stderr
DEFAULT_CLEAN_DAYS = 30
LIST_MIN_BYTES = 1 * MB  # smaller items are left out of the lists
CHANGE_MIN_BYTES = 100 * MB  # smaller changes between two scans are not reported
JSON_TOP = 15  # items per kind in `scan --json`
TEXT_TOP = 5  # items per kind in the text report
NOT_MEASURED_TOP = 30
PLAN_MAX_AGE = 24 * 3600  # `clean --apply` needs a dry run younger than this

_now = time.time  # tests replace it to make things look old


