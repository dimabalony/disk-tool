#!/usr/bin/env python3
"""See what fills your home folder, and clean what rebuilds itself.

One file, Python 3.9+ standard library only, made for macOS.
It looks at sizes and dates only: it never opens your files and never uses the network.
Run `explain` for the plain-words version.
"""

import argparse
import collections
import datetime
